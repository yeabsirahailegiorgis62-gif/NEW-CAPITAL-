generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  DRIVER
  LOGISTICS_ADMIN
  SYSTEM_ADMIN
}

enum VehicleCategory {
  SEDAN
  SUV
  PICKUP
  MINIBUS
  OTHER
}

enum VehicleOperationalStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
  INACTIVE
}

enum BookingStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

model Department {
  id          String   @id @default(uuid())
  code        String?  @unique
  name        String   @unique
  description String?
  headId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  head        User?    @relation("DepartmentHead", fields: [headId], references: [id])
  users       User[]   @relation("DepartmentMembers")

  @@map("departments")
}

model User {
  id                  String               @id @default(uuid())
  employeeId          String?              @unique
  name                String
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(EMPLOYEE)
  departmentId        String?
  phone               String?
  avatarUrl           String?
  jobTitle            String?
  licenseNumber       String?
  mustChangePassword  Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  department          Department?          @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headedDepartments   Department[]         @relation("DepartmentHead")
  bookings            Booking[]            @relation("RequesterBookings")
  assignedVehicles    VehicleAssignment[]  @relation("AssignedByLogistics")
  driverAssignments   VehicleAssignment[]  @relation("DriverAssignments")
  driverBookingDays   BookingDay[]         @relation("DriverBookingDays")
  driverFuelRecords   FuelRecord[]         @relation("DriverFuelRecords")
  reportedIssues      VehicleIssue[]       @relation("ReportedByUser")
  notifications       Notification[]       @relation("UserNotifications")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Vehicle {
  id                     String                   @id @default(uuid())
  name                   String
  make                   String
  model                  String
  registrationNumber     String                   @unique
  category               VehicleCategory          @default(SEDAN)
  passengerCapacity      Int                      @default(4)
  operationalStatus      VehicleOperationalStatus @default(ACTIVE)
  imageUrl               String?
  fuelLevel              Int?                     @default(85)
  mileage                Float?                   @default(15000)
  transmission           String?                  @default("Automatic")
  fuelType               String?                  @default("Petrol")
  manufacturingYear      Int?
  insuranceExpiry        DateTime?
  inspectionExpiry       DateTime?
  registrationExpiry     DateTime?
  lastMaintenanceDate    DateTime?
  nextMaintenanceDate    DateTime?
  nextMaintenanceOdometer Float?
  hasSafetyAlert         Boolean                  @default(false)
  description            String?
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  assignments            VehicleAssignment[]
  bookingDays            BookingDay[]
  issues                 VehicleIssue[]
  maintenances           VehicleMaintenance[]
  fuelRecords            FuelRecord[]
  preferredInBookings    Booking[]                @relation("PreferredVehicle")

  @@index([operationalStatus])
  @@index([registrationNumber])
  @@map("vehicles")
}

model Booking {
  id                 String        @id @default(uuid())
  bookingReference   String        @unique
  requesterId        String
  destination        String
  purpose            String
  departureAt        DateTime
  expectedReturnAt   DateTime
  actualDepartureAt  DateTime?
  actualReturnAt     DateTime?
  arrivedAt          DateTime?
  startOdometer      Float?
  endOdometer        Float?
  passengerCount     Int           @default(1)
  passengerDetails   Json?
  priority           String        @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  preferredVehicleId String?
  requiresDriver     Boolean       @default(false)
  requestType        String        @default("DAILY")  // "DAILY" | "WEEKLY"
  pickupLocation     String?
  contactPhone       String?
  status             BookingStatus @default(PENDING_APPROVAL)
  additionalNotes    String?
  tripNotes          String?
  delayReason        String?
  documentUrl        String?
  cancellationReason String?
  verificationToken  String?       @unique
  rejectionReason    String?
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  requester          User          @relation("RequesterBookings", fields: [requesterId], references: [id])
  preferredVehicle   Vehicle?      @relation("PreferredVehicle", fields: [preferredVehicleId], references: [id])
  assignments        VehicleAssignment[]
  notifications      Notification[]
  bookingDays        BookingDay[]

  @@index([status])
  @@index([requesterId])
  @@index([departureAt, expectedReturnAt])
  @@index([requestType])
  @@map("bookings")
}

model VehicleAssignment {
  id              String    @id @default(uuid())
  bookingId       String
  vehicleId       String
  assignedById    String
  driverId        String?
  driverName      String?
  driverPhone     String?
  status          String    @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION | CONFIRMED | DECLINED
  declineReason   String?
  confirmedAt     DateTime?
  declinedAt      DateTime?
  assignedAt      DateTime  @default(now())
  unassignedAt    DateTime?
  assignmentNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  assignedBy      User      @relation("AssignedByLogistics", fields: [assignedById], references: [id])
  driver          User?     @relation("DriverAssignments", fields: [driverId], references: [id])

  @@index([vehicleId, assignedAt, unassignedAt])
  @@index([driverId])
  @@index([bookingId])
  @@map("vehicle_assignments")
}

model VehicleIssue {
  id                     String        @id @default(uuid())
  vehicleId              String
  reportedById           String
  category               String        @default("MECHANICAL") // MECHANICAL, TIRES, ACCIDENT, ELECTRICAL, FUEL, WARNING_LIGHTS, EQUIPMENT, SAFETY, OTHER
  description            String
  severity               IssueSeverity @default(MEDIUM)
  status                 IssueStatus   @default(OPEN)
  odometer               Float?
  immediateSafetyConcern Boolean       @default(false)
  photoUrl               String?
  resolutionNotes        String?
  reportedAt             DateTime      @default(now())
  resolvedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  vehicle                Vehicle       @relation(fields: [vehicleId], references: [id])
  reportedBy             User          @relation("ReportedByUser", fields: [reportedById], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@map("vehicle_issues")
}

model VehicleMaintenance {
  id                  String    @id @default(uuid())
  vehicleId           String
  category            String    @default("PREVENTIVE") // PREVENTIVE, SCHEDULED, REPAIR, INSPECTION, TIRE, OIL_CHANGE, BRAKES, OTHER
  status              String    @default("SCHEDULED")  // REPORTED, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  reportedProblem     String?
  serviceDescription  String
  serviceDate         DateTime
  completedDate       DateTime?
  odometer            Float?
  serviceProvider     String?
  estimatedCost       Float?
  actualCost          Float?
  nextServiceDate     DateTime?
  nextServiceOdometer Float?
  notes               String?
  documentUrl         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
  @@map("vehicle_maintenances")
}

model FuelRecord {
  id               String    @id @default(uuid())
  vehicleId        String
  driverId         String?
  date             DateTime  @default(now())
  odometer         Float
  fuelQuantity     Float     // Liters
  unitPrice        Float     // Birr per Liter
  totalCost        Float     // Birr
  fuelStation      String?
  receiptReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver           User?     @relation("DriverFuelRecords", fields: [driverId], references: [id])

  @@index([vehicleId])
  @@index([driverId])
  @@index([date])
  @@map("fuel_records")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  bookingId   String?
  type        String    @default("INFO")
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient   User      @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorName      String?
  entityType     String
  entityId       String
  action         String
  previousValues Json?
  newValues      Json?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model BookingDay {
  id          String        @id @default(uuid())
  bookingId   String
  dayOfWeek   String        // MONDAY, TUESDAY, WEDNESDAY, etc.
  tripDate    DateTime
  timeSlot    String        @default("MORNING") // MORNING, AFTERNOON
  status      BookingStatus @default(PENDING_APPROVAL)
  vehicleId   String?
  driverId    String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  driver      User?         @relation("DriverBookingDays", fields: [driverId], references: [id])

  @@index([bookingId])
  @@index([tripDate])
  @@map("booking_days")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("GENERAL") // SECURITY, REQUEST_RULES, LIFECYCLE, ASSIGNMENT, MAINTENANCE, NOTIFICATIONS
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
